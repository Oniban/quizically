# Local development. Never commit real credentials.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Required: local MongoDB or an Atlas connection URI.
MONGO_URI=mongodb://127.0.0.1:27017/quizzically

# Required: generate a random secret of at least 32 characters before starting.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: same web client ID as client VITE_GOOGLE_CLIENT_ID.
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
